<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <!--
    authors - все авторы;
    id - ID автора;
    name - ФИО автора;
    bithday - день рождение автора (необязателен).
    -->

    <changeSet id="v1-1" author="Fazylov Ruslan">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="authors"/>
            </not>
        </preConditions>

        <createTable tableName="authors">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="nickname" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="birthday" type="date">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="v1-2" author="Ruslan Fazylov">
        <preConditions onFail="MARK_RAN">
                <tableIsEmpty tableName="authors"/>
        </preConditions>

        <loadData tableName="authors" file="db/data/authors-data.csv"/>
    </changeSet>

</databaseChangeLog>